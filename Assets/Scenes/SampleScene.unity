      m_Calls: []
  m_text: "2D PONG\n\n\u041F\u0420\u0410\u0412\u0418\u041B\u0410\n\n\u0417\u0430\u0434\u0430\u0447\u0430
    \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0438\u0433\u0440\u043E\u043A\u0430
    \u2014\n\u043D\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C
    \u043C\u044F\u0447 \u0437\u0430 \u0441\u0432\u043E\u044E \u0440\u0430\u043A\u0435\u0442\u043A\u0443.\n\n\u0417\u0430
    \u043A\u0430\u0436\u0434\u044B\u0439 \u0437\u0430\u0431\u0438\u0442\u044B\u0439
    \u043C\u044F\u0447 \u0438\u0433\u0440\u043E\u043A \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
    1 \u043E\u0447\u043A\u043E.\n\u0414\u043B\u044F \u043F\u043E\u0431\u0435\u0434\u044B
    \u0432 \u0440\u0430\u0443\u043D\u0434\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u043D\u0430\u0431\u0440\u0430\u0442\u044C 5 \u043E\u0447\u043A\u043E\u0432.\n\u0414\u043B\u044F
    \u043F\u043E\u0431\u0435\u0434\u044B \u0432 \u043C\u0430\u0442\u0447\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0432\u044B\u0438\u0433\u0440\u0430\u0442\u044C 2 \u0440\u0430\u0443\u043D\u0434\u0430.\n\n\u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415\n\n\u0421\u0438\u043D\u0438\u0439
    \u0438\u0433\u0440\u043E\u043A:\nW \u2014 \u0432\u0432\u0435\u0440\u0445\nS \u2014
    \u0432\u043D\u0438\u0437\n\n\u041A\u0440\u0430\u0441\u043D\u044B\u0439 \u0438\u0433\u0440\u043E\u043A:\n\u2191
    \u2014 \u0432\u0432\u0435\u0440\u0445\n\u2193 \u2014 \u0432\u043D\u0438\u0437"
